#Область Календарь

// Заполняет ВКМ_Календарь за годы демо-периода (пн–пт — рабочие дни).
// Используется набор записей: одна запись на год вместо 365 отдельных транзакций.
Процедура ЗаполнитьКалендарьЗаПериодДемоДанных(БазоваяДата, КоличествоДокументов, Журнал) Экспорт
	
	КонецПериодаДемо = ДобавитьМесяц(БазоваяДата, КоличествоДокументов);
	ГодНачала = Год(БазоваяДата);
	ГодОкончания = Макс(Год(КонецПериодаДемо), Год(ТекущаяДатаСеанса()));
	ЗаполненоГодов = 0;
	ПропущеноГодов = 0;
	
	Для ГодКалендаря = ГодНачала По ГодОкончания Цикл
		
		Если КалендарьЗаполненЗаГод(ГодКалендаря) Тогда
			ПропущеноГодов = ПропущеноГодов + 1;
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьКалендарьЗаГод(ГодКалендаря);
		ЗаполненоГодов = ЗаполненоГодов + 1;
		
	КонецЦикла;
	
	ДобавитьВЖурнал(Журнал, СтрШаблон(
		НСтр("ru = 'Календарь: заполнено лет — %1, пропущено (уже были данные) — %2, период %3–%4 гг.'"),
		ЗаполненоГодов,
		ПропущеноГодов,
		Формат(ГодНачала, "ЧГ=0"),
		Формат(ГодОкончания, "ЧГ=0")));
	
КонецПроцедуры

Функция КалендарьЗаполненЗаГод(ГодКалендаря)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Календарь.Дата) КАК КоличествоДней
	|ИЗ
	|	РегистрСведений.ВКМ_Календарь КАК Календарь
	|ГДЕ
	|	Календарь.Дата МЕЖДУ &НачалоГода И &КонецГода";
	Запрос.УстановитьПараметр("НачалоГода", Дата(ГодКалендаря, 1, 1));
	Запрос.УстановитьПараметр("КонецГода", Дата(ГодКалендаря, 12, 31));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		// В году 365/366 дней — считаем заполненным, если есть хотя бы 300 записей.
		Возврат Выборка.КоличествоДней >= 300;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ЗаполнитьКалендарьЗаГод(ГодКалендаря)
	
	Набор = РегистрыСведений.ВКМ_Календарь.СоздатьНаборЗаписей();
	ТекущаяДата = Дата(ГодКалендаря, 1, 1);
	КонецГода = Дата(ГодКалендаря, 12, 31);
	
	Пока ТекущаяДата <= КонецГода Цикл
		
		ДеньНедели = ДеньНедели(ТекущаяДата);
		Запись = Набор.Добавить();
		Запись.Дата = ТекущаяДата;
		Запись.РабочийДень = ?(ДеньНедели >= 1 И ДеньНедели <= 5, 1, 0);
		ТекущаяДата = ТекущаяДата + 1;
		
	КонецЦикла;
	
	Набор.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область ПодготовкаНСИ

Функция ПолучитьИлиСоздатьОрганизацию(Журнал)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДобавитьВЖурнал(Журнал, "Организация: используется существующая — " + Выборка.Ссылка);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Организации.СоздатьЭлемент();
	Объект.Наименование = "ООО ""ВКМ IT-Сервис""";
	Объект.НаименованиеПолное = "Общество с ограниченной ответственностью ""ВКМ IT-Сервис""";
	Объект.Записать();
	
	ДобавитьВЖурнал(Журнал, "Организация: создана — " + Объект.Ссылка);
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ПолучитьИлиСоздатьНоменклатуру(Наименование, Журнал)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Записать();
	
	ДобавитьВЖурнал(Журнал, "Номенклатура: создана — " + Наименование);
	Возврат Объект.Ссылка;
	
КонецФункции

Процедура УстановитьКонстантыНоменклатуры(НоменклатураАбонплата, НоменклатураРаботы, Журнал)
	
	Константы.ВКМ_НоменклатураАбонентскаяПлата.Установить(НоменклатураАбонплата);
	Константы.ВКМ_НоменклатураРаботыСпециалиста.Установить(НоменклатураРаботы);
	ДобавитьВЖурнал(Журнал, "Константы номенклатуры установлены.");
	
КонецПроцедуры

