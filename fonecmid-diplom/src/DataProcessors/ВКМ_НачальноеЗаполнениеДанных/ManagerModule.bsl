Процедура СоздатьУведомленияТелеграм(Количество, Журнал) Экспорт
	
	Создано = 0;
	Тексты = Новый Массив;
	Тексты.Добавить("Запланировано обслуживание клиента Альфа-Тех");
	Тексты.Добавить("Запланировано обслуживание клиента Бета-Софт");
	Тексты.Добавить("Запланировано обслуживание клиента Гамма");
	Тексты.Добавить("Запланировано обслуживание клиента Дельта-Системы");
	Тексты.Добавить("Запланировано обслуживание клиента Эпсилон-Групп");
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		Текст = Тексты[Индекс];
		Наименование = "Уведомление " + (Индекс + 1);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Уведомления.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВКМ_УведомленияТелеграмБоту КАК Уведомления
		|ГДЕ
		|	Уведомления.Наименование = &Наименование
		|	И НЕ Уведомления.ПометкаУдаления";
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		Если Не Запрос.Выполнить().Пустой() Тогда
			Продолжить;
		КонецЕсли;
		
		Объект = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
		Объект.Наименование = Наименование;
		Объект.ТекстСообщения = Текст;
		Объект.Записать();
		Создано = Создано + 1;
		
	КонецЦикла;
	
	ДобавитьВЖурнал(Журнал, "Уведомления Telegram: создано — " + Создано);
	
