#Область ПрограммныйИнтерфейс

// Заполняет демонстрационные данные для дипломной базы (требования tasks/testing.md):
//  - не менее 5 элементов в справочниках;
//  - не менее 5 документов каждого вида;
//  - не менее 3 строк в табличной части каждого документа.
// Пользователей ИБ с профилями создайте вручную.
//
// Параметры:
//  Журнал - Массив из Строка - сообщения о ходе заполнения.
//
Процедура ЗаполнитьДемонстрационныеДанные(Журнал) Экспорт
	
	Если Журнал = Неопределено Тогда
		Журнал = Новый Массив;
	КонецЕсли;
	
	КоличествоДокументов = 5;
	КоличествоСтрокТЧ = 3;
	БазоваяДата = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -5));
	
	ДобавитьВЖурнал(Журнал, "=== Начало заполнения демонстрационных данных ===");
	ДобавитьВЖурнал(Журнал, СтрШаблон(
		НСтр("ru = 'Параметры: %1 документов каждого вида, %2 строк в табличных частях.'"),
		КоличествоДокументов,
		КоличествоСтрокТЧ));
	
	Организация = Неопределено;
	НоменклатураАбонплата = Неопределено;
	НоменклатураРаботы = Неопределено;
	Контрагенты = Неопределено;
	Договоры = Неопределено;
	Сотрудники = Неопределено;
	
	ВыполнитьШаг(Журнал, "Календарь", "Заполнение производственного календаря");
	ЗаполнитьКалендарьЗаПериодДемоДанных(БазоваяДата, КоличествоДокументов, Журнал);
	
	ВыполнитьШаг(Журнал, "НСИ", "Подготовка организации и номенклатуры");
	Организация = ПолучитьИлиСоздатьОрганизацию(Журнал);
	НоменклатураАбонплата = ПолучитьИлиСоздатьНоменклатуру("Абонентское обслуживание IT", Журнал);
	НоменклатураРаботы = ПолучитьИлиСоздатьНоменклатуру("Работы специалиста по часам", Журнал);
	ПолучитьИлиСоздатьНоменклатуру("Консультация по IT-инфраструктуре", Журнал);
	ПолучитьИлиСоздатьНоменклатуру("Настройка серверного оборудования", Журнал);
	ПолучитьИлиСоздатьНоменклатуру("Аудит информационной безопасности", Журнал);
	УстановитьКонстантыНоменклатуры(НоменклатураАбонплата, НоменклатураРаботы, Журнал);
	
	ВыполнитьШаг(Журнал, "Контрагенты", "Создание контрагентов");
	Контрагенты = ПолучитьИлиСоздатьКонтрагентов(КоличествоДокументов, Журнал);
	
	ВыполнитьШаг(Журнал, "Договоры", "Создание договоров абонентского обслуживания");
	Договоры = ПолучитьИлиСоздатьДоговоры(Контрагенты, Организация, БазоваяДата, Журнал);
	
	ВыполнитьШаг(Журнал, "Сотрудники", "Создание сотрудников (справочник Пользователи)");
	Сотрудники = ПолучитьИлиСоздатьСотрудников(КоличествоДокументов, Журнал);
	
	ВыполнитьШаг(Журнал, "Условия оплаты", "Установка условий оплаты сотрудников");
	УстановитьУсловияОплатыСотрудников(Сотрудники, БазоваяДата, Журнал);
	
	ВыполнитьШаг(Журнал, "Обслуживание", "Создание документов обслуживания клиентов");
	СоздатьДокументыОбслуживания(Договоры, Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	
	ВыполнитьШаг(Журнал, "График отпусков", "Создание графиков отпусков");
	СоздатьГрафикиОтпусков(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	
	ВыполнитьШаг(Журнал, "Начисление ЗП", "Создание документов начисления зарплаты");
	СоздатьНачисленияЗарплаты(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	
	ВыполнитьШаг(Журнал, "Премии", "Создание документов начисления премий");
	СоздатьНачисленияПремий(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	
	ВыполнитьШаг(Журнал, "Выплата ЗП", "Создание документов выплаты зарплаты");
	СоздатьВыплатыЗарплаты(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	
	ВыполнитьШаг(Журнал, "Telegram", "Создание уведомлений Telegram");
	СоздатьУведомленияТелеграм(КоличествоДокументов, Журнал);
	
	ДобавитьВЖурнал(Журнал, "=== Заполнение завершено ===");
	ДобавитьВЖурнал(Журнал, "Далее: создайте пользователей ИБ с профилями и выполните массовое создание актов за нужные месяцы.");
	
КонецПроцедуры

// Точка входа для фонового задания (форма обработки).
//
Процедура ЗаполнитьДемонстрационныеДанныеВФоне(ПараметрыВыполнения, АдресРезультата) Экспорт
	
	Журнал = Новый Массив;
	
	Попытка
		ЗаполнитьДемонстрационныеДанные(Журнал);
	Исключение
		ДобавитьВЖурнал(Журнал, СтрШаблон(
			НСтр("ru = 'Критическая ошибка: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		ВызватьИсключение;
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Новый Структура("Журнал", Журнал), АдресРезультата);
	
КонецПроцедуры

