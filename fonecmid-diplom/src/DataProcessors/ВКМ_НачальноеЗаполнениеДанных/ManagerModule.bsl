#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет демонстрационные данные для дипломной базы.
// Пользователей ИБ с профилями создайте вручную (см. инструкцию в ответе ассистента).
//
// Параметры:
//  Журнал - Массив из Строка - сообщения о ходе заполнения.
//
Процедура ЗаполнитьДемонстрационныеДанные(Журнал) Экспорт
	
	Если Журнал = Неопределено Тогда
		Журнал = Новый Массив;
	КонецЕсли;
	
	КоличествоДокументов = 5;
	КоличествоСтрокТЧ = 3;
	БазоваяДата = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -5));
	
	ДобавитьВЖурнал(Журнал, "=== Начало заполнения демонстрационных данных ===");
	
	ЗаполнитьКалендарьЗаПериодДемоДанных(БазоваяДата, КоличествоДокументов, Журнал);
	
	Организация = ПолучитьИлиСоздатьОрганизацию(Журнал);
	НоменклатураАбонплата = ПолучитьИлиСоздатьНоменклатуру("Абонентское обслуживание IT", Журнал);
	НоменклатураРаботы = ПолучитьИлиСоздатьНоменклатуру("Работы специалиста по часам", Журнал);
	ПолучитьИлиСоздатьНоменклатуру("Консультация по IT-инфраструктуре", Журнал);
	ПолучитьИлиСоздатьНоменклатуру("Настройка серверного оборудования", Журнал);
	ПолучитьИлиСоздатьНоменклатуру("Аудит информационной безопасности", Журнал);
	УстановитьКонстантыНоменклатуры(НоменклатураАбонплата, НоменклатураРаботы, Журнал);
	
	Контрагенты = ПолучитьИлиСоздатьКонтрагентов(КоличествоДокументов, Журнал);
	Договоры = ПолучитьИлиСоздатьДоговоры(Контрагенты, Организация, БазоваяДата, Журнал);
	Сотрудники = ПолучитьИлиСоздатьСотрудников(КоличествоДокументов, Журнал);
	УстановитьУсловияОплатыСотрудников(Сотрудники, БазоваяДата, Журнал);
	
	СоздатьДокументыОбслуживания(Договоры, Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	СоздатьГрафикиОтпусков(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	СоздатьНачисленияЗарплаты(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	СоздатьНачисленияПремий(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	СоздатьВыплатыЗарплаты(Сотрудники, БазоваяДата, КоличествоДокументов, КоличествоСтрокТЧ, Журнал);
	СоздатьУведомленияТелеграм(КоличествоДокументов, Журнал);
	
	ДобавитьВЖурнал(Журнал, "=== Заполнение завершено ===");
	ДобавитьВЖурнал(Журнал, "Далее: создайте пользователей ИБ с профилями и выполните массовое создание актов за нужные месяцы.");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьВЖурнал(Журнал, Текст)
	Журнал.Добавить(Текст);
КонецПроцедуры

// Заполняет ВКМ_Календарь за все годы, в которых создаются демо-документы (нужно для расчёта оклада по графику).
Процедура ЗаполнитьКалендарьЗаПериодДемоДанных(БазоваяДата, КоличествоДокументов, Журнал)
	
	КонецПериодаДемо = ДобавитьМесяц(БазоваяДата, КоличествоДокументов);
	ГодНачала = Год(БазоваяДата);
	ГодОкончания = Макс(Год(КонецПериодаДемо), Год(ТекущаяДатаСеанса()));
	
	Для ГодКалендаря = ГодНачала По ГодОкончания Цикл
		ВКМ_РасчетЗарплаты.ЗаполнитьКалендарь(ГодКалендаря);
	КонецЦикла;
	
	ДобавитьВЖурнал(Журнал, "Календарь: заполнен за " + Формат(ГодНачала, "ЧГ=0")
		+ "–" + Формат(ГодОкончания, "ЧГ=0") + " гг.");
	
КонецПроцедуры

Функция ПолучитьИлиСоздатьОрганизацию(Журнал)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ДобавитьВЖурнал(Журнал, "Организация: используется существующая — " + Выборка.Ссылка);
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Организации.СоздатьЭлемент();
	Объект.Наименование = "ООО ""ВКМ IT-Сервис""";
	Объект.НаименованиеПолное = "Общество с ограниченной ответственностью ""ВКМ IT-Сервис""";
	Объект.Записать();
	
	ДобавитьВЖурнал(Журнал, "Организация: создана — " + Объект.Ссылка);
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ПолучитьИлиСоздатьНоменклатуру(Наименование, Журнал)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование = &Наименование
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.Записать();
	
	ДобавитьВЖурнал(Журнал, "Номенклатура: создана — " + Наименование);
	Возврат Объект.Ссылка;
	
КонецФункции

Процедура УстановитьКонстантыНоменклатуры(НоменклатураАбонплата, НоменклатураРаботы, Журнал)
	
	Константы.ВКМ_НоменклатураАбонентскаяПлата.Установить(НоменклатураАбонплата);
	Константы.ВКМ_НоменклатураРаботыСпециалиста.Установить(НоменклатураРаботы);
	ДобавитьВЖурнал(Журнал, "Константы номенклатуры установлены.");
	
КонецПроцедуры

