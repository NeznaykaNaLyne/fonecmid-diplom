Функция ПолучитьИлиСоздатьДоговоры(Контрагенты, Организация, БазоваяДата, Журнал)
	
	Результат = Новый Массив;
	НачалоДействия = НачалоГода(БазоваяДата);
	ОкончаниеДействия = КонецГода(ДобавитьМесяц(БазоваяДата, 12));
	СуммыАбонплаты = Новый Массив;
	СуммыАбонплаты.Добавить(15000);
	СуммыАбонплаты.Добавить(20000);
	СуммыАбонплаты.Добавить(10000);
	СуммыАбонплаты.Добавить(25000);
	СуммыАбонплаты.Добавить(18000);
	СтавкиЧаса = Новый Массив;
	СтавкиЧаса.Добавить(2500);
	СтавкиЧаса.Добавить(3000);
	СтавкиЧаса.Добавить(2000);
	СтавкиЧаса.Добавить(3500);
	СтавкиЧаса.Добавить(2800);
	
	Для Индекс = 0 По Контрагенты.Количество() - 1 Цикл
		
		Контрагент = Контрагенты[Индекс];
		НаименованиеДоговора = "Абонентское обслуживание " + (Индекс + 1);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Контрагент
		|	И Договоры.ВидДоговора = &ВидДоговора
		|	И НЕ Договоры.ПометкаУдаления";
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Добавить(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Объект.Владелец = Контрагент;
		Объект.Наименование = НаименованиеДоговора;
		Объект.Организация = Организация;
		Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание;
		Объект.ВКМ_ДатаНачалаДействия = НачалоДействия;
		Объект.ВКМ_ДатаОкончанияДействия = ОкончаниеДействия;
		Объект.ВКМ_СуммаАбонентскойПлаты = СуммыАбонплаты[Индекс];
		Объект.ВКМ_СтоимостьЧасаРаботы = СтавкиЧаса[Индекс];
		Объект.Записать();
		Результат.Добавить(Объект.Ссылка);
		ДобавитьВЖурнал(Журнал, "Договор: создан — " + Объект.Ссылка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИлиСоздатьСотрудников(Количество, Журнал)
	
	Результат = Новый Массив;
	Имена = Новый Массив;
	Имена.Добавить("Петров П.П.");
	Имена.Добавить("Сидоров С.С.");
	Имена.Добавить("Козлов К.К.");
	Имена.Добавить("Новиков Н.Н.");
	Имена.Добавить("Морозов М.М.");
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		Наименование = Имена[Индекс];
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование = &Наименование
		|	И НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.Недействителен";
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Добавить(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		// Только элемент справочника: пользователей ИБ создают вручную.
		// ОбменДанными.Загрузка отключает тяжёлую логику БСП при записи.
		Объект = Справочники.Пользователи.СоздатьЭлемент();
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Наименование = Наименование;
		Объект.Записать();
		Результат.Добавить(Объект.Ссылка);
		ДобавитьВЖурнал(Журнал, "Сотрудник (справочник): создан — " + Наименование);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьУсловияОплатыСотрудников(Сотрудники, БазоваяДата, Журнал) Экспорт
	
	Оклады = Новый Массив;
	Оклады.Добавить(80000);
	Оклады.Добавить(90000);
	Оклады.Добавить(75000);
	Оклады.Добавить(85000);
	Оклады.Добавить(70000);
	Проценты = Новый Массив;
	Проценты.Добавить(30);
	Проценты.Добавить(25);
	Проценты.Добавить(35);
	Проценты.Добавить(20);
	Проценты.Добавить(40);
	
	ПериодУсловий = НачалоМесяца(БазоваяДата);
	
	Для Индекс = 0 По Сотрудники.Количество() - 1 Цикл
		
		Сотрудник = Сотрудники[Индекс];
		
		Набор = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СоздатьНаборЗаписей();
		Набор.Отбор.Сотрудник.Установить(Сотрудник);
		Набор.Отбор.Период.Установить(ПериодУсловий);
		Набор.Прочитать();
		
		Если Набор.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Набор.Добавить();
		Запись.Период = ПериодУсловий;
		Запись.Сотрудник = Сотрудник;
		Запись.Оклад = Оклады[Индекс];
		Запись.ПроцентОтРабот = Проценты[Индекс];
		Набор.Записать();
		
	КонецЦикла;
	
	ДобавитьВЖурнал(Журнал, "Условия оплаты сотрудников установлены.");
	
КонецПроцедуры

