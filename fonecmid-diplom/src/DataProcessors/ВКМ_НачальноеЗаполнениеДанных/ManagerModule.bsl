			ДокументОбъект.Выплаты.Очистить();
			Для НомерСтроки = 1 По КоличествоСтрок Цикл
				СтрокаВыплаты = ДокументОбъект.Выплаты.Добавить();
				СтрокаВыплаты.Сотрудник = Сотрудники[(НомерСтроки - 1) % Сотрудники.Количество()];
				СтрокаВыплаты.Сумма = 5000 + НомерСтроки * 1000;
			КонецЦикла;
		КонецЕсли;
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Создано = Создано + 1;
		
	КонецЦикла;
	
