#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет пустую демо-базу (tasks/testing.md): 5 элементов справочников, 5 документов каждого вида, 3 строки в ТЧ.
// Пользователей ИБ создайте вручную.
//
Процедура ЗаполнитьДемонстрационныеДанные() Экспорт
	
	Количество = 5;
	СтрокВТЧ = 3;
	БазоваяДата = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -5));
	
	// --- 1. Организация (только Наименование) ---
	Организация = Справочники.Организации.СоздатьЭлемент();
	Организация.Наименование = "ООО ""ВКМ IT-Сервис""";
	Организация.Записать();
	
	// --- 2. Номенклатура ---
	ИменаНоменклатуры = Новый Массив;
	ИменаНоменклатуры.Добавить("Абонентское обслуживание IT");
	ИменаНоменклатуры.Добавить("Работы специалиста по часам");
	ИменаНоменклатуры.Добавить("Консультация по IT-инфраструктуре");
	ИменаНоменклатуры.Добавить("Настройка серверного оборудования");
	ИменаНоменклатуры.Добавить("Аудит информационной безопасности");
	
	Номенклатура = Новый Массив;
	Для Каждого Имя Из ИменаНоменклатуры Цикл
		Элемент = Справочники.Номенклатура.СоздатьЭлемент();
		Элемент.Наименование = Имя;
		Элемент.Записать();
		Номенклатура.Добавить(Элемент.Ссылка);
	КонецЦикла;
	
	Константы.ВКМ_НоменклатураАбонентскаяПлата.Установить(Номенклатура[0]);
	Константы.ВКМ_НоменклатураРаботыСпециалиста.Установить(Номенклатура[1]);
	
	// --- 3. Календарь (нужен для начисления оклада по графику) ---
	ГодНачала = Год(БазоваяДата);
	ГодОкончания = Макс(Год(ДобавитьМесяц(БазоваяДата, Количество)), Год(ТекущаяДатаСеанса()));
	Для ГодКалендаря = ГодНачала По ГодОкончания Цикл
		ВКМ_РасчетЗарплаты.ЗаполнитьКалендарь(ГодКалендаря);
	КонецЦикла;
	
	// --- 4. Контрагенты ---
	ИменаКлиентов = Новый Массив;
	ИменаКлиентов.Добавить("ООО Альфа-Тех");
	ИменаКлиентов.Добавить("ЗАО Бета-Софт");
	ИменаКлиентов.Добавить("ИП Гамма");
	ИменаКлиентов.Добавить("ООО Дельта-Системы");
	ИменаКлиентов.Добавить("АО Эпсилон-Групп");
	
	Контрагенты = Новый Массив;
	Для Каждого Имя Из ИменаКлиентов Цикл
		Элемент = Справочники.Контрагенты.СоздатьЭлемент();
		Элемент.Наименование = Имя;
		Элемент.Записать();
		Контрагенты.Добавить(Элемент.Ссылка);
	КонецЦикла;
	
	// --- 5. Договоры ---
	СуммыАбонплаты = Новый Массив;
	СуммыАбонплаты.Добавить(15000);
	СуммыАбонплаты.Добавить(20000);
	СуммыАбонплаты.Добавить(10000);
	СуммыАбонплаты.Добавить(25000);
	СуммыАбонплаты.Добавить(18000);
	СтавкиЧаса = Новый Массив;
	СтавкиЧаса.Добавить(2500);
	СтавкиЧаса.Добавить(3000);
	СтавкиЧаса.Добавить(2000);
	СтавкиЧаса.Добавить(3500);
	СтавкиЧаса.Добавить(2800);
	
	Договоры = Новый Массив;
	НачалоДействия = НачалоГода(БазоваяДата);
	ОкончаниеДействия = КонецГода(ДобавитьМесяц(БазоваяДата, 12));
	
	Для Индекс = 0 По Количество - 1 Цикл
		Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Договор.Владелец = Контрагенты[Индекс];
		Договор.Наименование = "Абонентское обслуживание " + (Индекс + 1);
		Договор.Организация = Организация.Ссылка;
		Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание;
		Договор.ВКМ_ДатаНачалаДействия = НачалоДействия;
		Договор.ВКМ_ДатаОкончанияДействия = ОкончаниеДействия;
		Договор.ВКМ_СуммаАбонентскойПлаты = СуммыАбонплаты[Индекс];
		Договор.ВКМ_СтоимостьЧасаРаботы = СтавкиЧаса[Индекс];
		Договор.Записать();
		Договоры.Добавить(Договор.Ссылка);
	КонецЦикла;
	
	// --- 6. Сотрудники (справочник Пользователи; ИБ — вручную) ---
	ИменаСотрудников = Новый Массив;
	ИменаСотрудников.Добавить("Петров П.П.");
	ИменаСотрудников.Добавить("Сидоров С.С.");
	ИменаСотрудников.Добавить("Козлов К.К.");
	ИменаСотрудников.Добавить("Новиков Н.Н.");
	ИменаСотрудников.Добавить("Морозов М.М.");
	
	Сотрудники = Новый Массив;
	Для Каждого Имя Из ИменаСотрудников Цикл
		Сотрудник = Справочники.Пользователи.СоздатьЭлемент();
		Сотрудник.ОбменДанными.Загрузка = Истина;
		Сотрудник.Наименование = Имя;
		Сотрудник.Записать();
		Сотрудники.Добавить(Сотрудник.Ссылка);
	КонецЦикла;
	
	// --- 7. Условия оплаты (до документов обслуживания и начисления ЗП) ---
	Оклады = Новый Массив;
	Оклады.Добавить(80000);
	Оклады.Добавить(90000);
	Оклады.Добавить(75000);
	Оклады.Добавить(85000);
	Оклады.Добавить(70000);
	Проценты = Новый Массив;
	Проценты.Добавить(30);
	Проценты.Добавить(25);
	Проценты.Добавить(35);
	Проценты.Добавить(20);
	Проценты.Добавить(40);
	ПериодУсловий = НачалоМесяца(БазоваяДата);
	
	Для Индекс = 0 По Количество - 1 Цикл
		Набор = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СоздатьНаборЗаписей();
		Набор.Отбор.Сотрудник.Установить(Сотрудники[Индекс]);
		Набор.Отбор.Период.Установить(ПериодУсловий);
		Запись = Набор.Добавить();
		Запись.Период = ПериодУсловий;
		Запись.Сотрудник = Сотрудники[Индекс];
		Запись.Оклад = Оклады[Индекс];
		Запись.ПроцентОтРабот = Проценты[Индекс];
		Набор.Записать();
	КонецЦикла;
	
	// --- 8. Обслуживание клиента (5 проведённых → регистры работ) ---
	Для Номер = 1 По Количество Цикл
		ДатаДокумента = ДобавитьМесяц(БазоваяДата, Номер - 1);
		Документ = Документы.ВКМ_ОбслуживаниеКлиента.СоздатьДокумент();
		Документ.Дата = ДатаДокумента;
		Документ.Клиент = Контрагенты[Номер - 1];
		Документ.Договор = Договоры[Номер - 1];
		Документ.Специалист = Сотрудники[(Номер - 1) % Количество];
		Документ.ДатаПроведенияРабот = ДатаДокумента;
		Документ.ВремяНачалаРаботПлан = Дата(1, 1, 1, 9, 0, 0);
		Документ.ВремяОкончанияРаботПлан = Дата(1, 1, 1, 12, 0, 0);
		Документ.ОписаниеПроблемы = "Демо-обслуживание №" + Номер;
		Для НомерСтроки = 1 По СтрокВТЧ Цикл
			Строка = Документ.ВыполненныеРаботы.Добавить();
			Строка.ОписаниеРабот = "Работа " + НомерСтроки;
			Строка.ФактическиПотраченоЧасов = 1 + НомерСтроки * 0.5;
			Строка.ЧасыКОплатеКлиенту = 1 + НомерСтроки * 0.5;
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	// --- 9. Графики отпусков (5 документов, без проведения) ---
	ГодГрафика = НачалоГода(БазоваяДата);
	Для Номер = 1 По Количество Цикл
		ГодДокумента = ДобавитьМесяц(ГодГрафика, (Номер - 1) * 12);
		Документ = Документы.ВКМ_ГрафикОтпусков.СоздатьДокумент();
		Документ.Дата = ГодДокумента;
		Документ.Год = ГодДокумента;
		Для НомерСтроки = 1 По СтрокВТЧ Цикл
			Строка = Документ.ОтпускаСотрудников.Добавить();
			Строка.Сотрудник = Сотрудники[(НомерСтроки - 1) % Количество];
			Строка.ДатаНачала = ДобавитьМесяц(ГодДокумента, НомерСтроки * 2);
			Строка.ДатаОкончания = Строка.ДатаНачала + 13;
			Строка.КоличествоДней = 14;
		КонецЦикла;
		Документ.Записать();
	КонецЦикла;
	
	// --- 10. Начисление ЗП (5 проведённых → регистры расчёта и взаиморасчётов) ---
	Для Номер = 1 По Количество Цикл
		МесяцНачисления = НачалоМесяца(ДобавитьМесяц(БазоваяДата, Номер - 1));
		Документ = Документы.ВКМ_НачислениеЗаработнойПлаты.СоздатьДокумент();
		Документ.Дата = КонецМесяца(МесяцНачисления);
		Документ.МесяцНачисления = МесяцНачисления;
		Для НомерСтроки = 1 По СтрокВТЧ Цикл
			Строка = Документ.Сотрудники.Добавить();
			Строка.Сотрудник = Сотрудники[(НомерСтроки - 1) % Количество];
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	// --- 11. Премии (5 проведённых) ---
	СуммыПремий = Новый Массив;
	СуммыПремий.Добавить(10000);
	СуммыПремий.Добавить(15000);
	СуммыПремий.Добавить(8000);
	
	Для Номер = 1 По Количество Цикл
		ДатаДокумента = КонецМесяца(ДобавитьМесяц(БазоваяДата, Номер - 1));
		Документ = Документы.ВКМ_НачислениеФиксированнойПремии.СоздатьДокумент();
		Документ.Дата = ДатаДокумента;
		Для НомерСтроки = 1 По СтрокВТЧ Цикл
			Строка = Документ.СписокСотрудников.Добавить();
			Строка.Сотрудник = Сотрудники[(НомерСтроки - 1) % Количество];
			Строка.СуммаПремии = СуммыПремий[(НомерСтроки - 1) % СуммыПремий.Количество()];
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	// --- 12. Выплаты ЗП (5 проведённых → расход по взаиморасчётам) ---
	Для Номер = 1 По Количество Цикл
		ДатаДокумента = КонецМесяца(ДобавитьМесяц(БазоваяДата, Номер));
		Документ = Документы.ВКМ_ВыплатаЗаработнойПлаты.СоздатьДокумент();
		Документ.Дата = ДатаДокумента;
		Для НомерСтроки = 1 По СтрокВТЧ Цикл
			Строка = Документ.Выплаты.Добавить();
			Строка.Сотрудник = Сотрудники[(НомерСтроки - 1) % Количество];
			Строка.Сумма = 5000 + НомерСтроки * 1000;
		КонецЦикла;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	
	// --- 13. Уведомления Telegram ---
	ТекстыУведомлений = Новый Массив;
	ТекстыУведомлений.Добавить("Запланировано обслуживание клиента Альфа-Тех");
	ТекстыУведомлений.Добавить("Запланировано обслуживание клиента Бета-Софт");
	ТекстыУведомлений.Добавить("Запланировано обслуживание клиента Гамма");
	ТекстыУведомлений.Добавить("Запланировано обслуживание клиента Дельта-Системы");
	ТекстыУведомлений.Добавить("Запланировано обслуживание клиента Эпсилон-Групп");
	
	Для Индекс = 0 По Количество - 1 Цикл
		Уведомление = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
		Уведомление.Наименование = "Уведомление " + (Индекс + 1);
		Уведомление.ТекстСообщения = ТекстыУведомлений[Индекс];
		Уведомление.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
