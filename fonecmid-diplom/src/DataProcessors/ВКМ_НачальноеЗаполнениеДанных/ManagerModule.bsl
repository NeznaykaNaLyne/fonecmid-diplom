Функция ПолучитьИлиСоздатьДоговоры(Контрагенты, Организация, БазоваяДата, Журнал)
	
	Результат = Новый Массив;
	НачалоДействия = НачалоГода(БазоваяДата);
	ОкончаниеДействия = КонецГода(ДобавитьМесяц(БазоваяДата, 12));
	СуммыАбонплаты = Новый Массив;
	СуммыАбонплаты.Добавить(15000);
	СуммыАбонплаты.Добавить(20000);
	СуммыАбонплаты.Добавить(10000);
	СуммыАбонплаты.Добавить(25000);
	СуммыАбонплаты.Добавить(18000);
	СтавкиЧаса = Новый Массив;
	СтавкиЧаса.Добавить(2500);
	СтавкиЧаса.Добавить(3000);
	СтавкиЧаса.Добавить(2000);
	СтавкиЧаса.Добавить(3500);
	СтавкиЧаса.Добавить(2800);
	
	Для Индекс = 0 По Контрагенты.Количество() - 1 Цикл
		
		Контрагент = Контрагенты[Индекс];
		НаименованиеДоговора = "Абонентское обслуживание " + (Индекс + 1);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ
		|	Договоры.Владелец = &Контрагент
		|	И Договоры.ВидДоговора = &ВидДоговора
		|	И НЕ Договоры.ПометкаУдаления";
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Добавить(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Объект.Владелец = Контрагент;
		Объект.Наименование = НаименованиеДоговора;
		Объект.Организация = Организация;
		Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание;
		Объект.ВКМ_ДатаНачалаДействия = НачалоДействия;
		Объект.ВКМ_ДатаОкончанияДействия = ОкончаниеДействия;
		Объект.ВКМ_СуммаАбонентскойПлаты = СуммыАбонплаты[Индекс];
		Объект.ВКМ_СтоимостьЧасаРаботы = СтавкиЧаса[Индекс];
		Объект.Записать();
		Результат.Добавить(Объект.Ссылка);
		ДобавитьВЖурнал(Журнал, "Договор: создан — " + Объект.Ссылка);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИлиСоздатьСотрудников(Количество, Журнал)
	
	Результат = Новый Массив;
	Имена = Новый Массив;
	Имена.Добавить("Петров П.П.");
	Имена.Добавить("Сидоров С.С.");
	Имена.Добавить("Козлов К.К.");
	Имена.Добавить("Новиков Н.Н.");
	Имена.Добавить("Морозов М.М.");
	
	Для Индекс = 0 По Количество - 1 Цикл
		
		Наименование = Имена[Индекс];
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Наименование = &Наименование
		|	И НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.Недействителен";
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.Добавить(Выборка.Ссылка);
			Продолжить;
		КонецЕсли;
		
		Объект = Справочники.Пользователи.СоздатьЭлемент();
		Объект.Наименование = Наименование;
		Объект.Записать();
		Результат.Добавить(Объект.Ссылка);
		ДобавитьВЖурнал(Журнал, "Сотрудник (справочник): создан — " + Наименование);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьУсловияОплатыСотрудников(Сотрудники, БазоваяДата, Журнал)
	
	Оклады = Новый Массив;
	Оклады.Добавить(80000);
	Оклады.Добавить(90000);
	Оклады.Добавить(75000);
	Оклады.Добавить(85000);
	Оклады.Добавить(70000);
	Проценты = Новый Массив;
	Проценты.Добавить(30);
	Проценты.Добавить(25);
	Проценты.Добавить(35);
	Проценты.Добавить(20);
	Проценты.Добавить(40);
	
	ПериодУсловий = НачалоМесяца(БазоваяДата);
	
	Для Индекс = 0 По Сотрудники.Количество() - 1 Цикл
		
		Сотрудник = Сотрудники[Индекс];
		
		Набор = РегистрыСведений.ВКМ_УсловияОплатыСотрудников.СоздатьНаборЗаписей();
		Набор.Отбор.Сотрудник.Установить(Сотрудник);
		Набор.Отбор.Период.Установить(ПериодУсловий);
		Набор.Прочитать();
		
		Если Набор.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Набор.Добавить();
		Запись.Период = ПериодУсловий;
		Запись.Сотрудник = Сотрудник;
		Запись.Оклад = Оклады[Индекс];
		Запись.ПроцентОтРабот = Проценты[Индекс];
		Набор.Записать();
		
	КонецЦикла;
	
	ДобавитьВЖурнал(Журнал, "Условия оплаты сотрудников установлены.");
	
КонецПроцедуры

Процедура СоздатьДокументыОбслуживания(Договоры, Сотрудники, БазоваяДата, Количество, КоличествоСтрок, Журнал)
	
	Создано = 0;
	
	Для НомерДокумента = 1 По Количество Цикл
		
		ДатаДокумента = ДобавитьМесяц(БазоваяДата, НомерДокумента - 1);
		Договор = Договоры[НомерДокумента - 1];
		Клиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Владелец");
		Специалист = Сотрудники[(НомерДокумента - 1) % Сотрудники.Количество()];
		
		Если ДокументОбслуживанияУжеСуществует(Договор, ДатаДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = Документы.ВКМ_ОбслуживаниеКлиента.СоздатьДокумент();
		ДокументОбъект.Дата = ДатаДокумента;
		ДокументОбъект.Клиент = Клиент;
		ДокументОбъект.Договор = Договор;
		ДокументОбъект.Специалист = Специалист;
		ДокументОбъект.ДатаПроведенияРабот = ДатаДокумента;
		ДокументОбъект.ВремяНачалаРаботПлан = Дата(1, 1, 1, 9, 0, 0);
		ДокументОбъект.ВремяОкончанияРаботПлан = Дата(1, 1, 1, 12, 0, 0);
		ДокументОбъект.ОписаниеПроблемы = "Демонстрационное обслуживание №" + НомерДокумента;
		
		Для НомерСтроки = 1 По КоличествоСтрок Цикл
			СтрокаРабот = ДокументОбъект.ВыполненныеРаботы.Добавить();
			СтрокаРабот.ОписаниеРабот = "Работа " + НомерСтроки + " по заявке " + НомерДокумента;
			СтрокаРабот.ФактическиПотраченоЧасов = 1 + НомерСтроки * 0.5;
			СтрокаРабот.ЧасыКОплатеКлиенту = 1 + НомерСтроки * 0.5;
		КонецЦикла;
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Создано = Создано + 1;
		
	КонецЦикла;
	
	ДобавитьВЖурнал(Журнал, "Обслуживание клиента: создано документов — " + Создано);
	
КонецПроцедуры

Функция ДокументОбслуживанияУжеСуществует(Договор, ДатаДокумента)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обслуживание.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВКМ_ОбслуживаниеКлиента КАК Обслуживание
	|ГДЕ
	|	Обслуживание.Договор = &Договор
	|	И НАЧАЛОПЕРИОДА(Обслуживание.Дата, МЕСЯЦ) = &Месяц
	|	И НЕ Обслуживание.ПометкаУдаления";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Месяц", НачалоМесяца(ДатаДокумента));
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура СоздатьГрафикиОтпусков(Сотрудники, БазоваяДата, Количество, КоличествоСтрок, Журнал)
	
	Создано = 0;
	ГодГрафика = НачалоГода(БазоваяДата);
	
	Для НомерДокумента = 1 По Количество Цикл
		
		ГодДокумента = ДобавитьМесяц(ГодГрафика, (НомерДокумента - 1) * 12);
		
		Если ГрафикОтпусковУжеСуществует(ГодДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = Документы.ВКМ_ГрафикОтпусков.СоздатьДокумент();
		ДокументОбъект.Дата = ГодДокумента;
		ДокументОбъект.Год = ГодДокумента;
		
		Для НомерСтроки = 1 По КоличествоСтрок Цикл
			Сотрудник = Сотрудники[(НомерСтроки - 1) % Сотрудники.Количество()];
			СтрокаОтпуска = ДокументОбъект.ОтпускаСотрудников.Добавить();
			СтрокаОтпуска.Сотрудник = Сотрудник;
			СтрокаОтпуска.ДатаНачала = ДобавитьМесяц(ГодДокумента, НомерСтроки * 2);
			СтрокаОтпуска.ДатаОкончания = СтрокаОтпуска.ДатаНачала + 13;
			СтрокаОтпуска.КоличествоДней = 14;
		КонецЦикла;
		
		ДокументОбъект.Записать();
		Создано = Создано + 1;
		
	КонецЦикла;
	
	ДобавитьВЖурнал(Журнал, "График отпусков: создано документов — " + Создано);
	
КонецПроцедуры

