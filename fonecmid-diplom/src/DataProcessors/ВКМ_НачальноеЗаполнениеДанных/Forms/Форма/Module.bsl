#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ОчиститьСообщения();
	ЗапуститьЗаполнениеВФоне();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗапуститьЗаполнениеВФоне()
	
	ДлительнаяОперация = ЗапуститьЗаполнениеНаСервере();
	
	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Истина;
	НастройкиОжидания.ТекстСообщения = НСтр("ru = 'Заполнение демонстрационных данных...'");
	
	Оповещение = Новый ОписаниеОповещения("ПослеЗаполненияВФоне", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, НастройкиОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьЗаполнениеНаСервере()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Начальное заполнение демо-данных'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.ВКМ_НачальноеЗаполнениеДанных.ЗаполнитьДемонстрационныеДанныеВФоне",
		Новый Структура,
		ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ПослеЗаполненияВФоне(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьЖурналЗаполнения(Результат.АдресРезультата);
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ПоказатьЖурналЗаполнения(Результат.АдресРезультата);
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьЖурналЗаполнения(АдресРезультата)
	
	ДанныеРезультата = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(ДанныеРезультата) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Журнал = Неопределено;
	Если Не ДанныеРезультата.Свойство("Журнал", Журнал) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаЖурнала Из Журнал Цикл
		ОбщегоНазначения.СообщитьПользователю(СтрокаЖурнала);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
