Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ВКМ_ДниОтпускаСотрудников.Записывать = Истина;
	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	ВидРасчетаОтпускные = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Отпускные;
	
	Для Каждого СтрокаОтпуска Из ОтпускаСотрудников Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаОтпуска.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоДней = КоличествоДнейОтпускаПоСтроке(
			СтрокаОтпуска.ДатаНачала,
			СтрокаОтпуска.ДатаОкончания,
			СтрокаОтпуска.КоличествоДней);
		
		Если КоличествоДней <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ГодОтпуска = ?(ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала), Год(СтрокаОтпуска.ДатаНачала), Год(Дата));
		
		Движение = Движения.ВКМ_ДниОтпускаСотрудников.Добавить();
		Движение.Период = ?(ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала), СтрокаОтпуска.ДатаНачала, Дата);
		Движение.Сотрудник = СтрокаОтпуска.Сотрудник;
		Движение.Год = ГодОтпуска;
		Движение.ВидУчетаОтпуска = Перечисления.ВКМ_ВидыУчетаОтпуска.Факт;
		Движение.КоличествоДней = КоличествоДней;
		
		Если ЗначениеЗаполнено(СтрокаОтпуска.ДатаНачала) И ЗначениеЗаполнено(СтрокаОтпуска.ДатаОкончания) Тогда
			УсловияОплаты = ВКМ_РасчетЗарплаты.ПолучитьУсловияОплатыСотрудника(СтрокаОтпуска.Сотрудник, СтрокаОтпуска.ДатаОкончания);
			ПолныйОклад = ?(УсловияОплаты.ЕстьУсловия, УсловияОплаты.Оклад, 0);
			РабочиеДниМесяца = ВКМ_РасчетЗарплаты.ПолучитьРабочиеДниПоКалендарю(
				НачалоМесяца(СтрокаОтпуска.ДатаНачала),
				КонецМесяца(СтрокаОтпуска.ДатаНачала));
			СуммаОтпускных = ?(РабочиеДниМесяца = 0, 0, Окр(ПолныйОклад * КоличествоДней / РабочиеДниМесяца, 2));
			
			ДвижениеОтпускные = Движения.ВКМ_ОсновныеНачисления.Добавить();
			ДвижениеОтпускные.ПериодРегистрации = Дата;
			ДвижениеОтпускные.ВидРасчета = ВидРасчетаОтпускные;
			ДвижениеОтпускные.Сотрудник = СтрокаОтпуска.Сотрудник;
			ДвижениеОтпускные.ПериодДействияНачало = СтрокаОтпуска.ДатаНачала;
			ДвижениеОтпускные.ПериодДействияКонец = СтрокаОтпуска.ДатаОкончания;
			ДвижениеОтпускные.Результат = СуммаОтпускных;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КоличествоДнейОтпускаПоСтроке(ДатаНачала, ДатаОкончания, КоличествоДней)
	
	Если ЗначениеЗаполнено(КоличествоДней) И КоличествоДней > 0 Тогда
		Возврат КоличествоДней;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат 0;
	КонецЕсли;
	
	КоличествоСекунд = НачалоДня(ДатаОкончания) - НачалоДня(ДатаНачала);
	Возврат Цел(КоличествоСекунд / 86400) + 1;
	
КонецФункции
