Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		РассчитатьСуммыНачисления(Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	
	ДатаРасчета = ?(ЗначениеЗаполнено(МесяцНачисления), МесяцНачисления, Дата);
	НачалоПериода = НачалоМесяца(ДатаРасчета);
	КонецПериода = КонецМесяца(ДатаРасчета);
	
	ВидРасчетаОклад = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_Оклад;
	ВидРасчетаПроцент = ПланыВидовРасчета.ВКМ_ОсновныеНачисления.ВКМ_ПроцентОтРабот;
	ВидРасчетаНДФЛ = ПланыВидовРасчета.ВКМ_Удержания.ВКМ_НДФЛ;
	
	ОкладыСотрудников = Новый Соответствие;
	
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		УсловияОплаты = ВКМ_РасчетЗарплаты.ПолучитьУсловияОплатыСотрудника(СтрокаСотрудника.Сотрудник, КонецПериода);
		Если Не УсловияОплаты.ЕстьУсловия Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для сотрудника " + СтрокаСотрудника.Сотрудник + " не заданы условия оплаты.";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
		ОкладыСотрудников.Вставить(СтрокаСотрудника.Сотрудник, УсловияОплаты.Оклад);
		
		ДвижениеОклад = Движения.ВКМ_ОсновныеНачисления.Добавить();
		ДвижениеОклад.ПериодРегистрации = Дата;
		ДвижениеОклад.ВидРасчета = ВидРасчетаОклад;
		ДвижениеОклад.Сотрудник = СтрокаСотрудника.Сотрудник;
		ДвижениеОклад.ПериодДействияНачало = НачалоПериода;
		ДвижениеОклад.ПериодДействияКонец = КонецПериода;
		
	КонецЦикла;
	
	Движения.ВКМ_ОсновныеНачисления.Записать();
	
	Для Каждого Движение Из Движения.ВКМ_ОсновныеНачисления Цикл
		
		Если Движение.ВидРасчета <> ВидРасчетаОклад Тогда
			Продолжить;
		КонецЕсли;
		
		Оклад = ОкладыСотрудников[Движение.Сотрудник];
		Движение.Результат = ВКМ_РасчетЗарплаты.РассчитатьОкладПоГрафикуРегистра(Ссылка, Движение.Сотрудник, Оклад);
		
	КонецЦикла;
	
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаОтРабот = ВКМ_РасчетЗарплаты.ПолучитьСуммуОтРаботЗаПериод(СтрокаСотрудника.Сотрудник, НачалоПериода, КонецПериода);
		Если СуммаОтРабот = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДвижениеПроцент = Движения.ВКМ_ОсновныеНачисления.Добавить();
		ДвижениеПроцент.ПериодРегистрации = Дата;
		ДвижениеПроцент.ВидРасчета = ВидРасчетаПроцент;
		ДвижениеПроцент.Сотрудник = СтрокаСотрудника.Сотрудник;
		ДвижениеПроцент.ПериодДействияНачало = НачалоПериода;
		ДвижениеПроцент.ПериодДействияКонец = КонецПериода;
		ДвижениеПроцент.Результат = СуммаОтРабот;
		
	КонецЦикла;
	
	Движения.ВКМ_ОсновныеНачисления.Записать();
	
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		ДвижениеНДФЛ = Движения.ВКМ_Удержания.Добавить();
		ДвижениеНДФЛ.ПериодРегистрации = Дата;
		ДвижениеНДФЛ.ВидРасчета = ВидРасчетаНДФЛ;
		ДвижениеНДФЛ.Сотрудник = СтрокаСотрудника.Сотрудник;
		ДвижениеНДФЛ.ПериодДействияНачало = НачалоПериода;
		ДвижениеНДФЛ.ПериодДействияКонец = КонецПериода;
		ДвижениеНДФЛ.БазовыйПериодНачало = НачалоПериода;
		ДвижениеНДФЛ.БазовыйПериодКонец = КонецПериода;
		
	КонецЦикла;
	
	Движения.ВКМ_Удержания.Записать();
	
	ВКМ_РасчетЗарплаты.РассчитатьНДФЛПоБазеОсновныхНачислений(Движения.ВКМ_Удержания, Ссылка, ВидРасчетаНДФЛ);
	Движения.ВКМ_Удержания.Записать();
	
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		ДвижениеВзаиморасчеты = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		ДвижениеВзаиморасчеты.Период = Дата;
		ДвижениеВзаиморасчеты.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВзаиморасчеты.Сотрудник = СтрокаСотрудника.Сотрудник;
		ДвижениеВзаиморасчеты.Сумма = СтрокаСотрудника.СуммаКВыплате;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РассчитатьСуммыНачисления(Отказ)
	
	ДатаРасчета = ?(ЗначениеЗаполнено(МесяцНачисления), МесяцНачисления, Дата);
	НачалоПериода = НачалоМесяца(ДатаРасчета);
	КонецПериода = КонецМесяца(ДатаРасчета);
	
	Для Каждого СтрокаСотрудника Из Сотрудники Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		УсловияОплаты = ВКМ_РасчетЗарплаты.ПолучитьУсловияОплатыСотрудника(СтрокаСотрудника.Сотрудник, КонецПериода);
		Если Не УсловияОплаты.ЕстьУсловия Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Для сотрудника " + СтрокаСотрудника.Сотрудник + " не заданы условия оплаты.";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
		Оклад = УсловияОплаты.Оклад;
		СуммаОтРабот = ВКМ_РасчетЗарплаты.ПолучитьСуммуОтРаботЗаПериод(СтрокаСотрудника.Сотрудник, НачалоПериода, КонецПериода);
		Отпускные = 0;
		Начислено = Оклад + СуммаОтРабот + Отпускные;
		НДФЛ = ВКМ_РасчетЗарплаты.РассчитатьНДФЛ(Начислено);
		КВыплате = Начислено - НДФЛ;
		
		СтрокаСотрудника.СуммаОклада = Оклад;
		СтрокаСотрудника.СуммаПроцентОтРабот = СуммаОтРабот;
		СтрокаСотрудника.СуммаОтпускных = Отпускные;
		СтрокаСотрудника.СуммаНачислено = Начислено;
		СтрокаСотрудника.СуммаНДФЛ = НДФЛ;
		СтрокаСотрудника.СуммаКВыплате = КВыплате;
		
	КонецЦикла;
	
КонецПроцедуры
