Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	
	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода = КонецМесяца(Дата);
	ВидРасчетаПремия = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ВКМ_ФиксированнаяПремия;
	ВидРасчетаНДФЛ = ПланыВидовРасчета.ВКМ_Удержания.ВКМ_НДФЛ;
	
	Для Каждого СтрокаСотрудника Из СписокСотрудников Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаПремии = ?(ЗначениеЗаполнено(СтрокаСотрудника.СуммаПремии), СтрокаСотрудника.СуммаПремии, 0);
		
		Если СуммаПремии < 0 Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Сумма премии не может быть отрицательной. Сотрудник: " + СтрокаСотрудника.Сотрудник;
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;
		
		ДвижениеНачисление = Движения.ВКМ_ДополнительныеНачисления.Добавить();
		ДвижениеНачисление.ПериодРегистрации = Дата;
		ДвижениеНачисление.Сотрудник = СтрокаСотрудника.Сотрудник;
		ДвижениеНачисление.ВидРасчета = ВидРасчетаПремия;
		ДвижениеНачисление.ПериодДействияНачало = НачалоПериода;
		ДвижениеНачисление.ПериодДействияКонец = КонецПериода;
		ДвижениеНачисление.Результат = СуммаПремии;
		
		Если СуммаПремии > 0 Тогда
			ДвижениеУдержание = Движения.ВКМ_Удержания.Добавить();
			ДвижениеУдержание.ПериодРегистрации = Дата;
			ДвижениеУдержание.Сотрудник = СтрокаСотрудника.Сотрудник;
			ДвижениеУдержание.ВидРасчета = ВидРасчетаНДФЛ;
			ДвижениеУдержание.ПериодДействияНачало = НачалоПериода;
			ДвижениеУдержание.ПериодДействияКонец = КонецПериода;
			ДвижениеУдержание.БазовыйПериодНачало = НачалоПериода;
			ДвижениеУдержание.БазовыйПериодКонец = КонецПериода;
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.ВКМ_ДополнительныеНачисления.Записать();
	Движения.ВКМ_Удержания.Записать();
	
	ВКМ_РасчетЗарплаты.РассчитатьНДФЛПоБазеДополнительныхНачислений(Движения.ВКМ_Удержания, Ссылка, ВидРасчетаНДФЛ);
	Движения.ВКМ_Удержания.Записать();
	
	ЗаполнитьСуммыСотрудниковПоДвижениям(ВидРасчетаПремия, ВидРасчетаНДФЛ);
	
	Для Каждого СтрокаСотрудника Из СписокСотрудников Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		ДвижениеВзаиморасчеты = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		ДвижениеВзаиморасчеты.Период = Дата;
		ДвижениеВзаиморасчеты.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеВзаиморасчеты.Сотрудник = СтрокаСотрудника.Сотрудник;
		ДвижениеВзаиморасчеты.Сумма = СтрокаСотрудника.СуммаКВыплате;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСуммыСотрудниковПоДвижениям(ВидРасчетаПремия, ВидРасчетаНДФЛ)
	
	Для Каждого СтрокаСотрудника Из СписокСотрудников Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаСотрудника.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		Суммы = ВКМ_РасчетЗарплаты.ПолучитьСуммыПремииПоДвижениям(
			Движения.ВКМ_ДополнительныеНачисления,
			Движения.ВКМ_Удержания,
			СтрокаСотрудника.Сотрудник,
			ВидРасчетаПремия,
			ВидРасчетаНДФЛ);
		
		СтрокаСотрудника.СуммаНДФЛ = Суммы.СуммаНДФЛ;
		СтрокаСотрудника.СуммаКВыплате = Суммы.СуммаКВыплате;
		
	КонецЦикла;
	
КонецПроцедуры
