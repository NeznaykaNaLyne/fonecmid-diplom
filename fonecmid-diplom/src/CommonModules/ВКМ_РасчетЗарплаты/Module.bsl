// Заполняет регистр сведений ВКМ_Календарь на указанный год (пн–пт — рабочие дни).
//
// Параметры:
//  Год - Число - календарный год.
//
Процедура ЗаполнитьКалендарь(Год) Экспорт
	
	НачалоГода = Дата(Год, 1, 1);
	КонецГода = Дата(Год, 12, 31);
	
	ТекущаяДата = НачалоГода;
	Пока ТекущаяДата <= КонецГода Цикл
		
		ДеньНедели = ДеньНедели(ТекущаяДата);
		РабочийДень = ?(ДеньНедели >= 1 И ДеньНедели <= 5, 1, 0);
		
		МенеджерЗаписи = РегистрыСведений.ВКМ_Календарь.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Дата = ТекущаяДата;
		МенеджерЗаписи.РабочийДень = РабочийДень;
		МенеджерЗаписи.Записать();
		
		ТекущаяДата = ТекущаяДата + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает условия оплаты сотрудника на дату среза.
//
Функция ПолучитьУсловияОплатыСотрудника(Сотрудник, ДатаСреза) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Условия.Оклад КАК Оклад,
	|	Условия.ПроцентОтРабот КАК ПроцентОтРабот
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(
	|		&ДатаСреза,
	|		Сотрудник = &Сотрудник) КАК Условия";
	
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("ЕстьУсловия, Оклад, ПроцентОтРабот", Истина, Выборка.Оклад, Выборка.ПроцентОтРабот);
	КонецЕсли;
	
	Возврат Новый Структура("ЕстьУсловия, Оклад, ПроцентОтРабот", Ложь, 0, 0);
	
КонецФункции

// Возвращает сумму начислений за выполненные работы за период.
//
Функция ПолучитьСуммуОтРаботЗаПериод(Сотрудник, НачалоПериода, КонецПериода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Обороты.СуммаКОплатеОборот), 0) КАК СуммаОтРабот
	|ИЗ
	|	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		,
	|		Сотрудник = &Сотрудник) КАК Обороты";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаОтРабот;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Рассчитывает оклад по данным графика регистра расчета (с учетом вытеснения).
//
// Параметры:
//  Регистратор - ДокументСсылка - документ-регистратор движений;
//  Сотрудник - СправочникСсылка.Пользователи - сотрудник;
//  Оклад - Число - полный месячный оклад;
//  НачалоПериода - Дата - начало периода действия (для резервного расчета по календарю);
//  КонецПериода - Дата - конец периода действия.
//
Функция РассчитатьОкладПоГрафикуРегистра(Регистратор, Сотрудник, Оклад, НачалоПериода = Неопределено, КонецПериода = Неопределено) Экспорт
	
	Норма = ПолучитьРабочиеДниПоГрафикуРегистра(
		Регистратор,
		Сотрудник,
		ВидПериодаРегистраРасчета.ПериодДействия);
	Факт = ПолучитьРабочиеДниПоГрафикуРегистра(
		Регистратор,
		Сотрудник,
		ВидПериодаРегистраРасчета.ФактическийПериодДействия);
	
	Если Норма = 0
		И ЗначениеЗаполнено(НачалоПериода)
		И ЗначениеЗаполнено(КонецПериода) Тогда
		
		Норма = ПолучитьРабочиеДниПоКалендарю(НачалоПериода, КонецПериода);
		Факт = Норма;
		
	КонецЕсли;
	
	Возврат ?(Норма = 0, 0, Окр(Оклад * Факт / Норма, 2));
	
КонецФункции

// Возвращает сумму рабочих дней по графику регистра расчета основных начислений.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ-регистратор;
//  Сотрудник - СправочникСсылка.Пользователи - сотрудник;
//  ВидПериодаГрафика - ВидПериодаРегистраРасчета - норма или фактический период действия.
//
Функция ПолучитьРабочиеДниПоГрафикуРегистра(Регистратор, Сотрудник, ВидПериодаГрафика) Экспорт
	
	ДанныеГрафика = ПолучитьДанныеГрафикаОсновныхНачислений(Регистратор, Сотрудник, ВидПериодаГрафика);
	Если ДанныеГрафика.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат ДанныеГрафика[0].РабочийДень;
	
КонецФункции

// Возвращает таблицу данных графика регистра расчета (механизм графика регистра).
//
Функция ПолучитьДанныеГрафикаОсновныхНачислений(Регистратор, Сотрудник, ВидПериодаГрафика) Экспорт
	
	Отбор = Новый Структура("Регистратор, Сотрудник", Регистратор, Сотрудник);
	Возврат РегистрыРасчета.ВКМ_ОсновныеНачисления.ПолучитьДанныеГрафика(Отбор, ВидПериодаГрафика);
	
КонецФункции

// Возвращает количество рабочих дней по регистру сведений ВКМ_Календарь за период.
//
Функция ПолучитьРабочиеДниПоКалендарю(НачалоПериода, КонецПериода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Календарь.РабочийДень), 0) КАК РабочиеДни
	|ИЗ
	|	РегистрСведений.ВКМ_Календарь КАК Календарь
	|ГДЕ
	|	Календарь.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", НачалоДня(КонецПериода));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РабочиеДни;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Возвращает соответствие Сотрудник -> сумма базы для НДФЛ по виртуальным таблицам регистра удержаний.
//
// Параметры:
//  Регистратор - ДокументСсылка - документ-регистратор удержаний;
//  НачалоБазовогоПериода - Дата - начало базового периода (для совместимости API);
//  КонецБазовогоПериода - Дата - конец базового периода (для совместимости API);
//  ВидРасчетаНДФЛ - ПланВидовРасчетаСсылка.ВКМ_Удержания - вид расчета НДФЛ.
//
Функция ПолучитьБазуНДФЛПоСотрудникам(Регистратор, НачалоБазовогоПериода, КонецБазовогоПериода, ВидРасчетаНДФЛ = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидРасчетаНДФЛ) Тогда
		ВидРасчетаНДФЛ = ПланыВидовРасчета.ВКМ_Удержания.ВКМ_НДФЛ;
	КонецЕсли;
	
	БазаПоСотрудникам = Новый Соответствие;
	
	ДополнитьБазуНДФЛИзВиртуальнойТаблицы(
		БазаПоСотрудникам,
		Регистратор,
		Неопределено,
		Неопределено,
		"ВКМ_ОсновныеНачисления",
		ВидРасчетаНДФЛ);
	ДополнитьБазуНДФЛИзВиртуальнойТаблицы(
		БазаПоСотрудникам,
		Регистратор,
		Неопределено,
		Неопределено,
		"ВКМ_ДополнительныеНачисления",
		ВидРасчетаНДФЛ);
	
	Возврат БазаПоСотрудникам;
	
КонецФункции

Процедура ДополнитьБазуНДФЛИзВиртуальнойТаблицы(БазаПоСотрудникам, Регистратор, Сотрудник, НомерСтроки, ИмяБазовогоРегистра, ВидРасчетаНДФЛ)
	
	Измерения = Новый Массив;
	Измерения.Добавить("Сотрудник");
	
	ИмяВиртуальнойТаблицы = "РегистрРасчета.ВКМ_Удержания.База" + ИмяБазовогоРегистра;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	База.Сотрудник КАК Сотрудник,
	|	СУММА(База.РезультатБаза) КАК СуммаБаза
	|ИЗ
	|	" + ИмяВиртуальнойТаблицы + "(
	|		&Измерения,
	|		&Измерения,
	|		,
	|		Регистратор = &Регистратор
	|			И ВидРасчета = &ВидРасчетаНДФЛ
	|			И (&БезОтбораПоСотруднику ИЛИ Сотрудник = &Сотрудник)
	|			И (&БезОтбораПоНомеруСтроки ИЛИ НомерСтроки = &НомерСтроки)) КАК База
	|СГРУППИРОВАТЬ ПО
	|	База.Сотрудник";
	
	Запрос.УстановитьПараметр("Измерения", Измерения);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("ВидРасчетаНДФЛ", ВидРасчетаНДФЛ);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
	Запрос.УстановитьПараметр("БезОтбораПоСотруднику", Не ЗначениеЗаполнено(Сотрудник));
	Запрос.УстановитьПараметр("БезОтбораПоНомеруСтроки", Не ЗначениеЗаполнено(НомерСтроки) Или НомерСтроки = 0);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекущаяСумма = БазаПоСотрудникам.Получить(Выборка.Сотрудник);
		Если ТекущаяСумма = Неопределено Тогда
			ТекущаяСумма = 0;
		КонецЕсли;
		БазаПоСотрудникам.Вставить(Выборка.Сотрудник, ТекущаяСумма + Выборка.СуммаБаза);
	КонецЦикла;
	
КонецПроцедуры

// Заполняет результат НДФЛ в движениях удержаний по виртуальным таблицам База регистра расчета.
//
Процедура РассчитатьНДФЛПоБазеУдержаний(ДвиженияУдержания, Регистратор, ВидРасчетаНДФЛ = Неопределено) Экспорт
	
	Если ДвиженияУдержания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидРасчетаНДФЛ) Тогда
		ВидРасчетаНДФЛ = ПланыВидовРасчета.ВКМ_Удержания.ВКМ_НДФЛ;
	КонецЕсли;
	
	Для Каждого Движение Из ДвиженияУдержания Цикл
		
		БазаПоСотрудникам = Новый Соответствие;
		ДополнитьБазуНДФЛИзВиртуальнойТаблицы(
			БазаПоСотрудникам,
			Регистратор,
			Движение.Сотрудник,
			Движение.НомерСтроки,
			"ВКМ_ОсновныеНачисления",
			ВидРасчетаНДФЛ);
		ДополнитьБазуНДФЛИзВиртуальнойТаблицы(
			БазаПоСотрудникам,
			Регистратор,
			Движение.Сотрудник,
			Движение.НомерСтроки,
			"ВКМ_ДополнительныеНачисления",
			ВидРасчетаНДФЛ);
		
		СуммаБаза = 0;
		ЗначениеБазы = БазаПоСотрудникам.Получить(Движение.Сотрудник);
		Если ЗначениеБазы <> Неопределено Тогда
			СуммаБаза = ЗначениеБазы;
		КонецЕсли;
		
		Движение.Результат = РассчитатьНДФЛ(СуммаБаза);
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет результат НДФЛ в движениях удержаний по сумме основных начислений документа-регистратора.
//
Процедура РассчитатьНДФЛПоБазеОсновныхНачислений(ДвиженияУдержания, Регистратор, ВидРасчетаНДФЛ = Неопределено) Экспорт
	
	РассчитатьНДФЛПоБазеУдержаний(ДвиженияУдержания, Регистратор, ВидРасчетаНДФЛ);
	
КонецПроцедуры

// Заполняет результат НДФЛ в движениях удержаний по сумме дополнительных начислений документа-регистратора.
//
Процедура РассчитатьНДФЛПоБазеДополнительныхНачислений(ДвиженияУдержания, Регистратор, ВидРасчетаНДФЛ = Неопределено) Экспорт
	
	РассчитатьНДФЛПоБазеУдержаний(ДвиженияУдержания, Регистратор, ВидРасчетаНДФЛ);
	
КонецПроцедуры

// Возвращает соответствие Сотрудник -> сумма результатов основных начислений по регистратору.
//
Функция ПолучитьРезультатыОсновныхНачисленийПоРегистратору(Регистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник КАК Сотрудник,
	|	СУММА(Начисления.Результат) КАК СуммаНачисления
	|ИЗ
	|	РегистрРасчета.ВКМ_ОсновныеНачисления КАК Начисления
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|СГРУППИРОВАТЬ ПО
	|	Начисления.Сотрудник";
	
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Выборка.СуммаНачисления);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает соответствие Сотрудник -> сумма результатов дополнительных начислений по регистратору.
//
Функция ПолучитьРезультатыДополнительныхНачисленийПоРегистратору(Регистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник КАК Сотрудник,
	|	СУММА(Начисления.Результат) КАК СуммаНачисления
	|ИЗ
	|	РегистрРасчета.ВКМ_ДополнительныеНачисления КАК Начисления
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|СГРУППИРОВАТЬ ПО
	|	Начисления.Сотрудник";
	
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Выборка.СуммаНачисления);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Суммирует ресурс Результат движений регистра расчета по сотруднику и виду расчета.
//
Функция ПолучитьРезультатПоСотрудникуИВидуРасчета(ДвиженияРегистра, Сотрудник, ВидРасчета) Экспорт
	
	Сумма = 0;
	Для Каждого Движение Из ДвиженияРегистра Цикл
		Если Движение.Сотрудник = Сотрудник И Движение.ВидРасчета = ВидРасчета Тогда
			Сумма = Сумма + Движение.Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

// Возвращает структуру сумм строки начисления зарплаты по движениям регистров расчета.
//
Функция ПолучитьСуммыНачисленияЗарплатыПоДвижениям(
	ДвиженияОсновные,
	ДвиженияУдержания,
	Сотрудник,
	ВидРасчетаОклад,
	ВидРасчетаПроцент,
	ВидРасчетаОтпускные,
	ВидРасчетаНДФЛ) Экспорт
	
	СуммаОклада = ПолучитьРезультатПоСотрудникуИВидуРасчета(ДвиженияОсновные, Сотрудник, ВидРасчетаОклад);
	СуммаПроцентОтРабот = ПолучитьРезультатПоСотрудникуИВидуРасчета(ДвиженияОсновные, Сотрудник, ВидРасчетаПроцент);
	СуммаОтпускных = ПолучитьРезультатПоСотрудникуИВидуРасчета(ДвиженияОсновные, Сотрудник, ВидРасчетаОтпускные);
	СуммаНДФЛ = ПолучитьРезультатПоСотрудникуИВидуРасчета(ДвиженияУдержания, Сотрудник, ВидРасчетаНДФЛ);
	СуммаНачислено = СуммаОклада + СуммаПроцентОтРабот + СуммаОтпускных;
	СуммаКВыплате = СуммаНачислено - СуммаНДФЛ;
	
	Возврат Новый Структура(
		"СуммаОклада, СуммаПроцентОтРабот, СуммаОтпускных, СуммаНачислено, СуммаНДФЛ, СуммаКВыплате",
		СуммаОклада,
		СуммаПроцентОтРабот,
		СуммаОтпускных,
		СуммаНачислено,
		СуммаНДФЛ,
		СуммаКВыплате);
	
КонецФункции

// Возвращает структуру сумм строки премии по движениям регистров расчета.
//
Функция ПолучитьСуммыПремииПоДвижениям(
	ДвиженияДополнительные,
	ДвиженияУдержания,
	Сотрудник,
	ВидРасчетаПремия,
	ВидРасчетаНДФЛ) Экспорт
	
	СуммаПремии = ПолучитьРезультатПоСотрудникуИВидуРасчета(ДвиженияДополнительные, Сотрудник, ВидРасчетаПремия);
	СуммаНДФЛ = ПолучитьРезультатПоСотрудникуИВидуРасчета(ДвиженияУдержания, Сотрудник, ВидРасчетаНДФЛ);
	
	Возврат Новый Структура(
		"СуммаПремии, СуммаНДФЛ, СуммаКВыплате",
		СуммаПремии,
		СуммаНДФЛ,
		СуммаПремии - СуммаНДФЛ);
	
КонецФункции

// Возвращает суммы основных начислений сотрудника за период действия.
//
Функция ПолучитьСуммыОсновныхНачисленийЗаПериод(
	Сотрудник,
	НачалоПериода,
	КонецПериода,
	ВидРасчетаОклад,
	ВидРасчетаПроцент,
	ВидРасчетаОтпускные) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА Начисления.ВидРасчета = &ВидРасчетаОклад
	|			ТОГДА Начисления.Результат
	|		ИНАЧЕ 0
	|	КОНЕЦ), 0) КАК СуммаОклада,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА Начисления.ВидРасчета = &ВидРасчетаПроцент
	|			ТОГДА Начисления.Результат
	|		ИНАЧЕ 0
	|	КОНЕЦ), 0) КАК СуммаПроцентОтРабот,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА Начисления.ВидРасчета = &ВидРасчетаОтпускные
	|			ТОГДА Начисления.Результат
	|		ИНАЧЕ 0
	|	КОНЕЦ), 0) КАК СуммаОтпускных
	|ИЗ
	|	РегистрРасчета.ВКМ_ОсновныеНачисления КАК Начисления
	|ГДЕ
	|	Начисления.Сотрудник = &Сотрудник
	|	И Начисления.ПериодДействияНачало <= &КонецПериода
	|	И Начисления.ПериодДействияКонец >= &НачалоПериода";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("ВидРасчетаОклад", ВидРасчетаОклад);
	Запрос.УстановитьПараметр("ВидРасчетаПроцент", ВидРасчетаПроцент);
	Запрос.УстановитьПараметр("ВидРасчетаОтпускные", ВидРасчетаОтпускные);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура(
			"СуммаОклада, СуммаПроцентОтРабот, СуммаОтпускных",
			Выборка.СуммаОклада,
			Выборка.СуммаПроцентОтРабот,
			Выборка.СуммаОтпускных);
	КонецЕсли;
	
	Возврат Новый Структура("СуммаОклада, СуммаПроцентОтРабот, СуммаОтпускных", 0, 0, 0);
	
КонецФункции

