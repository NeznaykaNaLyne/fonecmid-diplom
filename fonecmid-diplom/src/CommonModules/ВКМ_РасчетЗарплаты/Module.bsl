// Заполняет регистр сведений ВКМ_Календарь на указанный год (пн–пт — рабочие дни).
//
// Параметры:
//  Год - Число - календарный год.
//
Процедура ЗаполнитьКалендарь(Год) Экспорт
	
	НачалоГода = Дата(Год, 1, 1);
	КонецГода = Дата(Год, 12, 31);
	
	ТекущаяДата = НачалоГода;
	Пока ТекущаяДата <= КонецГода Цикл
		
		ДеньНедели = ДеньНедели(ТекущаяДата);
		РабочийДень = ?(ДеньНедели >= 1 И ДеньНедели <= 5, 1, 0);
		
		МенеджерЗаписи = РегистрыСведений.ВКМ_Календарь.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Дата = ТекущаяДата;
		МенеджерЗаписи.РабочийДень = РабочийДень;
		МенеджерЗаписи.Записать();
		
		ТекущаяДата = ТекущаяДата + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает условия оплаты сотрудника на дату среза.
//
Функция ПолучитьУсловияОплатыСотрудника(Сотрудник, ДатаСреза) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Условия.Оклад КАК Оклад,
	|	Условия.ПроцентОтРабот КАК ПроцентОтРабот
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(
	|		&ДатаСреза,
	|		Сотрудник = &Сотрудник) КАК Условия";
	
	Запрос.УстановитьПараметр("ДатаСреза", ДатаСреза);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("ЕстьУсловия, Оклад, ПроцентОтРабот", Истина, Выборка.Оклад, Выборка.ПроцентОтРабот);
	КонецЕсли;
	
	Возврат Новый Структура("ЕстьУсловия, Оклад, ПроцентОтРабот", Ложь, 0, 0);
	
КонецФункции

// Возвращает сумму начислений за выполненные работы за период.
//
Функция ПолучитьСуммуОтРаботЗаПериод(Сотрудник, НачалоПериода, КонецПериода) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Обороты.СуммаКОплатеОборот), 0) КАК СуммаОтРабот
	|ИЗ
	|	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы.Обороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		,
	|		Сотрудник = &Сотрудник) КАК Обороты";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаОтРабот;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Рассчитывает оклад по данным графика регистра расчета (с учетом вытеснения).
//
Функция РассчитатьОкладПоГрафикуРегистра(Регистратор, Сотрудник, Оклад) Экспорт
	
	Отбор = Новый Структура("Регистратор, Сотрудник", Регистратор, Сотрудник);
	ДанныеГрафика = РегистрыРасчета.ВКМ_ОсновныеНачисления.ПолучитьДанныеГрафика(Отбор, ВидПериодаРегистраРасчета.ПериодДействия);
	Норма = ?(ДанныеГрафика.Количество() > 0, ДанныеГрафика[0].РабочийДень, 0);
	
	ДанныеФакт = РегистрыРасчета.ВКМ_ОсновныеНачисления.ПолучитьДанныеГрафика(Отбор, ВидПериодаРегистраРасчета.ФактическийПериодДействия);
	Факт = ?(ДанныеФакт.Количество() > 0, ДанныеФакт[0].РабочийДень, 0);
	
	Возврат ?(Норма = 0, 0, Окр(Оклад * Факт / Норма, 2));
	
КонецФункции

// Возвращает соответствие Сотрудник -> сумма начислений по регистратору (для НДФЛ).
//
Функция ПолучитьСуммуНачисленийОсновныеПоСотрудникам(Регистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник КАК Сотрудник,
	|	СУММА(Начисления.Результат) КАК СуммаБаза
	|ИЗ
	|	РегистрРасчета.ВКМ_ОсновныеНачисления КАК Начисления
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|СГРУППИРОВАТЬ ПО
	|	Начисления.Сотрудник";
	
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Выборка.СуммаБаза);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполняет результат НДФЛ в движениях удержаний по сумме основных начислений документа-регистратора.
//
Процедура РассчитатьНДФЛПоБазеОсновныхНачислений(ДвиженияУдержания, Регистратор, ВидРасчетаНДФЛ = Неопределено) Экспорт
	
	РассчитатьНДФЛПоБазеНачислений(ДвиженияУдержания, ПолучитьСуммуНачисленийОсновныеПоСотрудникам(Регистратор));
	
КонецПроцедуры

// Возвращает соответствие Сотрудник -> сумма дополнительных начислений по регистратору.
//
Функция ПолучитьСуммуНачисленийДополнительныеПоСотрудникам(Регистратор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Сотрудник КАК Сотрудник,
	|	СУММА(Начисления.Результат) КАК СуммаБаза
	|ИЗ
	|	РегистрРасчета.ВКМ_ДополнительныеНачисления КАК Начисления
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|СГРУППИРОВАТЬ ПО
	|	Начисления.Сотрудник";
	
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Выборка.СуммаБаза);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполняет результат НДФЛ в движениях удержаний по сумме дополнительных начислений документа-регистратора.
//
Процедура РассчитатьНДФЛПоБазеДополнительныхНачислений(ДвиженияУдержания, Регистратор) Экспорт
	
	РассчитатьНДФЛПоБазеНачислений(ДвиженияУдержания, ПолучитьСуммуНачисленийДополнительныеПоСотрудникам(Регистратор));
	
КонецПроцедуры

Процедура РассчитатьНДФЛПоБазеНачислений(ДвиженияУдержания, БазаПоСотрудникам)
	
	Для Каждого Движение Из ДвиженияУдержания Цикл
		СуммаБаза = 0;
		ЗначениеБазы = БазаПоСотрудникам.Получить(Движение.Сотрудник);
		Если ЗначениеБазы <> Неопределено Тогда
			СуммаБаза = ЗначениеБазы;
		КонецЕсли;
		Движение.Результат = РассчитатьНДФЛ(СуммаБаза);
	КонецЦикла;
	
КонецПроцедуры

// Рассчитывает НДФЛ от суммы начислений (13%).
//
Функция РассчитатьНДФЛ(СуммаНачислений) Экспорт
	Возврат Окр(СуммаНачислений * 0.13, 2);
КонецФункции

#КонецОбласти

#КонецЕсли
