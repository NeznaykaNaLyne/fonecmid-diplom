Процедура РассчитатьНДФЛПоБазеНачислений(ДвиженияУдержания, БазаПоСотрудникам)
	
	Для Каждого Движение Из ДвиженияУдержания Цикл
		СуммаБаза = 0;
		ЗначениеБазы = БазаПоСотрудникам.Получить(Движение.Сотрудник);
		Если ЗначениеБазы <> Неопределено Тогда
			СуммаБаза = ЗначениеБазы;
		КонецЕсли;
		Движение.Результат = РассчитатьНДФЛ(СуммаБаза);
	КонецЦикла;
	
КонецПроцедуры

// Рассчитывает НДФЛ от суммы начислений (13%).
//
Функция РассчитатьНДФЛ(СуммаНачислений) Экспорт
	Возврат Окр(СуммаНачислений * 0.13, 2);
КонецФункции

// Возвращает длительность отпуска в календарных днях.
//
// Параметры:
//  ДатаНачала - Дата - дата начала отпуска;
//  ДатаОкончания - Дата - дата окончания отпуска;
//  КоличествоДней - Число - явно указанное количество дней (если заполнено).
//
// Возвращаемое значение:
//  Число - количество календарных дней отпуска.
//
Функция КоличествоДнейОтпуска(ДатаНачала, ДатаОкончания, КоличествоДней = 0) Экспорт
	
	Если ЗначениеЗаполнено(КоличествоДней) И КоличествоДней > 0 Тогда
		Возврат КоличествоДней;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат 0;
	КонецЕсли;
	
	КоличествоСекунд = НачалоДня(ДатаОкончания) - НачалоДня(ДатаНачала);
	Возврат Цел(КоличествоСекунд / 86400) + 1;
	
КонецФункции

#КонецОбласти

